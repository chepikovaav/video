# Скопировать в /etc/video-ai.env и поправить (chmod 600).
# Адрес, по которому открывается страница (без слеша в конце):
AI_ALLOWED_ORIGINS=https://video.example.com
# Ключи можно не задавать — тогда каждый вводит свой во вкладке «Настройки».
# Если задать, ими пользуется любой, кто пройдёт Cloudflare Access.
OPENAI_API_KEY=
ARK_API_KEY=
