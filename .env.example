# Скопируй этот файл в .env (рядом с ai_server.py) и впиши ключи.
# Пустое значение = ключа нет, его поле останется на странице.
OPENAI_API_KEY=
GEMINI_API_KEY=
ARK_API_KEY=

# Библиотека AI-портретов BytePlus (необязательно):
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
BYTEPLUS_TOS_BUCKET=

# Codex (подписка ChatGPT вместо ключа OpenAI), необязательно:
# CODEX_BIN=/opt/homebrew/bin/codex   # если Codex не находится сам
# CODEX_EFFORT=low                    # low быстрее, medium/high точнее
# CODEX_PARALLEL=2                    # сколько запросов Codex одновременно
